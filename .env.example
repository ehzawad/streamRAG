# Required for live indexing and model calls. Never commit the real value.
OPENAI_API_KEY=

OPENAI_MODEL=gpt-5.6-sol
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072
OPENAI_EMBEDDING_TIMEOUT_S=45
OPENAI_EMBEDDING_MAX_RETRIES=1
OPENAI_MODEL_MAX_RETRIES=1
REASONING_EFFORT=medium
TRIGGER_REASONING_EFFORT=low
SUMMARY_REASONING_EFFORT=low
OPENAI_SERVICE_TIER=default
TRIGGER_TIMEOUT_S=4.0
RETRIEVAL_TIMEOUT_S=6.0
ANSWER_TIMEOUT_S=30.0
SUMMARY_TIMEOUT_S=8.0
TURN_IDLE_TIMEOUT_S=120
SESSION_RETENTION_HOURS=24

# Empty URL uses persisted local mode. Set URL/key for Docker or managed Qdrant.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=./data/qdrant
RUNTIME_DB=./data/runtime.sqlite3
METRICS_LOG=./bench/results/requests.jsonl

# The single evaluation dataset is intentionally review-gated. Set to 1 only for local
# implementation checks before human approval; never label those runs final.
ALLOW_UNREVIEWED_DATASET=0

APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
